# ============================================================
# Enterprise RAG Quality Engineering Platform
# .env.example  –  Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider ---
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_ORG_ID=                          # optional

# --- LLM Model settings ---
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Embedding model ---
# Leave blank to use the default in config/settings.py
EMBEDDING_MODEL=

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Set to "local" to use an in-process persistent client, "http" for a remote server
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./data/vectorstore

# --- RAG Pipeline ---
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                         # set to false in production

# --- Streamlit ---
STREAMLIT_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# --- Evaluation ---
BENCHMARK_FILE=./data/benchmarks/golden_qa.jsonl
EVAL_OUTPUT_DIR=./reports
